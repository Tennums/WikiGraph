# Which wiki to serve. Must match the dumps you fetched and the name the ingest wrote.
WIKI=simplewiki

# Where the built graph and the dumps live. On the server, point these at the NAS.
DATA_DIR=./data
ZIM_DIR=./data/zim

# The ZIM's filename without extension, e.g. wikipedia_en_all_nopic_2026-06.
# Leave empty to hide the "read the article" button.
ZIM_BOOK=

# A URL the *browser* can reach -- your server's LAN address, not a compose name.
KIWIX_URL=http://localhost:8080

API_PORT=3000
KIWIX_PORT=8080
MAX_NODES=6000
