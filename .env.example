# Which wiki to serve. Must match the dumps you fetched and the name the ingest wrote:
# the ingest reads <DATA_DIR>/dumps/<WIKI>-latest-*.sql.gz and writes
# <DATA_DIR>/graph/<WIKI>.csr and .db, and the API opens that same pair.
WIKI=enwiki

# Everything lives here. The compose file mounts <DATA_DIR>/dumps read-only into the
# ingest and <DATA_DIR>/graph read-only into the API.
DATA_DIR=/media/vault/WikiGraph
ZIM_DIR=/media/vault/WikiGraph/zim

# The ZIM's filename without extension, e.g. wikipedia_en_all_maxi_2026-08.
# Leave empty to hide the "read the article" button.
ZIM_BOOK=

# A URL the *browser* can reach. Behind Caddy that is the public hostname — not a
# compose service name, and not localhost, since the reader's machine resolves it.
KIWIX_URL=https://wiki.example.com

# Host ports. Only needed to bypass Caddy; comment the `ports:` lines out in
# docker-compose.yml once the proxy fronts both services.
API_PORT=3000
KIWIX_PORT=8080

# The renderer re-plans its whole layout every animated frame. Past ~6000 nodes the
# animation degrades faster than the picture improves.
MAX_NODES=6000
