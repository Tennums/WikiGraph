# Which wiki to serve. Must match the dumps you fetched and the name the ingest wrote:
# the ingest reads <DATA_DIR>/dumps/<WIKI>-latest-*.sql.gz and writes
# <DATA_DIR>/graph/<WIKI>.csr and .db, and the API opens that same pair.
WIKI=enwiki

# Everything lives here. The compose file mounts <DATA_DIR>/dumps read-only into the
# ingest, <DATA_DIR>/graph read-only into the API, and <DATA_DIR>/state read-write
# into the API for the reading list and saved views (a few small JSON files).
DATA_DIR=/media/vault/WikiGraph
ZIM_DIR=/media/vault/WikiGraph/zim

# The book name kiwix-serve derives from the ZIM: its filename, lowercased, without the
# extension. Leave empty to hide the "read the article" button.
ZIM_BOOK=wikipedia_en_all_maxi_2026-08

# Where the *browser* reaches Kiwix. Both services sit behind one hostname, so this is
# that hostname plus the prefix kiwix-serve is started with (-r /kiwix). Changing the
# prefix means changing it in both places.
KIWIX_URL=https://wikigraph.docker.home.arpa/kiwix

# Local scratch for the ingest — the edge file and the SQLite build, ~15 GB for enwiki.
# Must NOT be on the NAS: SQLite needs file locking that network mounts do not provide.
# Leave as the named volume to use the Docker host's disk, or give a local host path.
SCRATCH_DIR=wikigraph-scratch

# Host ports, only used if you uncomment the `ports:` lines in docker-compose.yml to
# bypass Caddy while debugging. Nothing is published otherwise.
API_PORT=3000
KIWIX_PORT=8080

# Articles shorter than this many bytes of wikitext are hidden unless the view says
# otherwise. 1000 is about 150 words; enwiki's stubs sit well below it.
MIN_LEN_DEFAULT=1000

# The renderer re-plans its whole layout every animated frame. Past ~6000 nodes the
# animation degrades faster than the picture improves.
MAX_NODES=6000
